# t1-revive shellcheck configuration (shellcheck >= 0.9)
shell=bash
source-path=SCRIPTDIR
external-sources=true

# Turn every optional check on, then switch off the ones that only add noise here:
enable=all
# SC2250 require-variable-braces: ${x} everywhere is style, not safety.
disable=SC2250
# SC2292 prefer-bracket-bracket and SC2248 require-double-quotes: both are pure style from
# `enable=all`. POSIX `[ ]` and unquoted `$rc` in arithmetic-ish places are correct bash; the
# code base mixes both spellings deliberately and 250+ nags would bury the real findings.
disable=SC2292,SC2248
# SC2249 require-default-case: several `case` statements here are single-branch filters
# (`case "$mp" in ''|-|none) mp='' ;; esac`) where a default case would be dead code. The
# dispatchers that do need one are covered by test/cli.bats (unknown subcommand -> exit 2).
disable=SC2249
# SC2312 check-extra-masked-returns: we run with `set -uo pipefail` (no -e) and check
# the statuses that matter explicitly; flagging every $(cmd | cmd) is noise.
disable=SC2312
# SC2310/SC2311 check-set-e-suppressed: about `set -e`, which the contract forbids.
disable=SC2310,SC2311
# SC2154 check-unassigned-uppercase: T1R_* variables are set by bin/t1-revive and the
# environment; every lib file would otherwise flag each reference.
disable=SC2154
