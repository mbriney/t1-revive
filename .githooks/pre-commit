#!/usr/bin/env bash
# t1-revive pre-commit hook: identifier scan + bash -n on the staged content.
# Enable with:  make hooks   (sets git config core.hooksPath .githooks)
set -uo pipefail

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
fail=0
errf=$(mktemp "${TMPDIR:-/tmp}/t1r-precommit.XXXXXX") || exit 1
trap 'rm -f "$errf"' EXIT

if ! bash tools/scan-identifiers.sh --staged; then
  fail=1
fi

bats_staged=0
while IFS= read -r -d '' f; do
  case $f in
    *.bats) bats_staged=1 ;;
    *.sh|*.bash|bin/*|.githooks/*) ;;
    *) continue ;;
  esac
  content=$(git show ":$f" 2>/dev/null) || continue
  case $f in
    *.bats|*.sh|*.bash) ;;
    *) [[ $content == '#!'*bash* ]] || continue ;;   # bin/* and hooks: only bash scripts
  esac
  # `@test NAME {` is bats syntax and not bash, so rewrite the header into a function header
  # first; the rest of a .bats file is plain bash. bash -n parses and runs nothing, so `load`
  # (which resolves relative to test/) never executes and the file needs no context.
  if [[ $f == *.bats ]]; then
    content=$(printf '%s\n' "$content" | sed -E 's/^[[:space:]]*@test[[:space:]].*\{[[:space:]]*$/_bats_test() {/')
  fi
  if ! bash -n <(printf '%s\n' "$content") 2>"$errf"; then
    echo "pre-commit: bash -n failed for $f:" >&2
    sed 's|/dev/fd/[0-9]*|'"$f"'|' "$errf" >&2
    fail=1
  fi
  : >"$errf"
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

# The staged .bats files are parsed above, one by one. `bats --count` adds a check of the whole
# work tree (a suite can break on a helper that is not staged), but only on bats >= 1.11: older
# versions count the `@test` headers with a lexer and never notice a syntax error at all.
if (( bats_staged )) && command -v bats >/dev/null 2>&1; then
  if ! bats --count test/ >/dev/null; then
    echo "pre-commit: bats cannot parse test/ (see above)" >&2
    fail=1
  fi
fi

if (( fail )); then
  echo "pre-commit: refusing the commit (see above). Bypass only with --no-verify and a reason." >&2
  exit 1
fi
exit 0
