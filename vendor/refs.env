# Header wording is LGPL 2.1 without an "or later" clause -> LGPL-2.1-only.
LIBIRECOVERY_UPSTREAM_URL=https://github.com/libimobiledevice/libirecovery
LIBIRECOVERY_BASE_COMMIT=95dec3aa25b1e30654ca107eb971971f6a216520
