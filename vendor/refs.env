LIBIMOBILEDEVICE_GLUE_VERSION=1.3.2-5-gda770a7
LIBIMOBILEDEVICE_GLUE_PATCH=
LIBIMOBILEDEVICE_GLUE_LICENSE=LGPL-2.1-or-later
LIBIMOBILEDEVICE_GLUE_TARBALL_SHA256=6fb173c3c9ea9a4a21f9362a9eee7660f68f0aecc9d59251726f3ae4b39a26b6

