# t1-revive vendored libimobiledevice stack: pinned upstream refs.
# Sourced by build.sh and read by packaging/arch/PKGBUILD.
# Plain KEY=VALUE, bash-compatible, no expansions, no command substitution.
# One block per component, in build (dependency) order.
#
#   <NAME>_UPSTREAM_URL     upstream git repository
#   <NAME>_BASE_COMMIT      full sha of the commit the proven binaries were built from
#   <NAME>_VERSION          `git describe --tags` of that commit; exported as RELEASE_VERSION to
#                           autogen.sh so tarball builds and patched worktrees report the same
#                           --version as the proven binaries (git-version-gen would otherwise
#                           append -dirty or fall back to NEWS)
#   <NAME>_PATCH            file under vendor/patches/ applied on top of the base commit (empty = none)
#   <NAME>_LICENSE          SPDX expression, verified from the tree's COPYING* and source headers
#   <NAME>_TARBALL_SHA256   sha256 of <UPSTREAM_URL>/archive/<BASE_COMMIT>.tar.gz, for the Arch
#                           package (GitHub regenerates these archives, so re-check with
#                           `updpkgsums` if makepkg reports a mismatch; the commit is the truth)
#   <NAME>_FORK_URL         (patched components) the maintainer's fork whose branch is exactly
#   <NAME>_FORK_BRANCH      BASE_COMMIT + PATCH; `build.sh --from-forks` clones this instead of
#                           upstream+patch. Both routes must produce identical trees.
#
# Names use underscores where the project name has dashes (libimobiledevice-glue -> LIBIMOBILEDEVICE_GLUE).

T1R_VENDOR_ORDER="libplist libimobiledevice-glue libtatsu libirecovery libusbmuxd libimobiledevice usbmuxd idevicerestore"

LIBPLIST_UPSTREAM_URL=https://github.com/libimobiledevice/libplist
LIBPLIST_BASE_COMMIT=32428abacb909988e8e960a8845a6430b17b6a60
LIBPLIST_VERSION=2.7.0-66-g32428ab
LIBPLIST_PATCH=
LIBPLIST_LICENSE=LGPL-2.1-or-later
LIBPLIST_TARBALL_SHA256=2f979e317ebbbfb0f2e850475f106c326df65d63d8d6bcc02076083ecae64478

LIBIMOBILEDEVICE_GLUE_UPSTREAM_URL=https://github.com/libimobiledevice/libimobiledevice-glue
